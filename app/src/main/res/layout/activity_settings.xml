<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/fpsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FPS: 30" />

        <SeekBar
            android:id="@+id/fpsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/alphaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Прозрачность: 1.0" />

        <SeekBar
            android:id="@+id/alphaBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/thickLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Толщина: 3" />

        <SeekBar
            android:id="@+id/thickBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/colorHex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="#RRGGBB"
            android:inputType="text" />

        <EditText
            android:id="@+id/fovEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="FOV (px)"
            android:inputType="number" />

        <EditText
            android:id="@+id/speedEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Скорость наведения (ms)"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/aimCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Включить авто-наведение" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить" />
    </LinearLayout>
</ScrollView>
